#!/usr/bin/env bash
# Fake `id` for the ac test-suite: `id -u` reports $MOCK_UID (default 0) so
# root and non-root behaviour can be tested without real privileges. Any other
# invocation is passed to the real id.

if [ "${1:-}" = "-u" ]; then
    printf '%s\n' "${MOCK_UID:-0}"
else
    exec /usr/bin/id "$@"
fi
